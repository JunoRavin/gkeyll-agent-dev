#!/bin/sh

OSTYPE=`uname -o`
MACHINE=`uname -n`
USER=`whoami`
echo "# OS type is $OSTYPE on $MACHINE user $USER"

# Defaults
PREFIX=${HOME}/gkylsoft
APP=pkpm
ALLTARGETS=gkeyll
INSTALLTARGET=gkeyll

FIN_APP_LIB_DIR="-L../\${BUILD_DIR}/pkpm"
FIN_APP_LIB_NAME=${FIN_APP_LIB_DIR}/libg0pkpm.so
FIN_APP_LIB="-lg0pkpm"

# default build options
CC=cc
GPUCXX=
ARCH_FLAGS=-march=native
CUDA_ARCH=70
GPU_ARCH=

USE_CUDSS=
USE_HIP=
USE_LUA=
USE_MPI=
USE_NCCL=
USE_RCCL=

ROCM_PATH=${ROCM_PATH}

CONF_LUA_LIB=luajit-5.1

# Location of CUDA math libraries
CUDAMATH_LIB_DIR=

# ----------------------------------------------------------------------------
# Function definitions
# ----------------------------------------------------------------------------

show_help() {
cat <<EOF

./configure [options=value]

Configure GkeyllZero build system. This step is optional if you are
okay with the default parameters.

NOTE: At present, the configure script DOES NOT check if you have
specified valid paths. YOU are responsible for setting them correctly!

CC                         C compiler to use. Default is system cc
GPUCXX                     GPU device-code compiler. Default is nvcc when CC=nvcc;
                           set to hipcc to build with HIP/ROCm.
ARCH_FLAGS                 Architecture flags to use. Default '-march=native'
CUDA_ARCH                  CUDA architecture flag to specify compute capability.
                           Use CUDA_ARCH=70 for V100, CUDA_ARCH=80 for A100, etc.
                           Default is CUDA_ARCH=70.
GPU_ARCH                   GPU architecture, passed verbatim to nvcc (sm_<arch>) or
                           hipcc (--offload-arch). Defaults to CUDA_ARCH on the
                           CUDA path; required on the HIP path (e.g. gfx90a).
ROCM_PATH                  Path to the ROCm install. Defaults to the ROCM_PATH env
                           var. Required when --use-hip=yes.

-h
--help                     This help.
--prefix=DIR               Prefix where GkeyllZero is installed
                           Default is $HOME/gkylsoft/

--use-hip                  [no] Build HIP/ROCm GPU code (mutually exclusive with
                           CC=nvcc).
--use-mpi                  [no] Build MPI-dependent code
--use-nccl                 [no] Build NCCL-dependent code (CUDA only)
--use-rccl                 [no] Build RCCL-dependent code (HIP only; mutually
                           exclusive with --use-nccl).
--use-cudss                [no] Build CUDSS-dependent code
--use-lua                  [no] Build Lua dependent code
--app                      [all] What app to build? One of
			   core, moments, vlasov, gyrokinetic, pkpm, all

Library Includes and Locations

--lapack-inc               Location of Lapack headers.
--lapack-lib               Location of Lapack library.
--lapack-lib-name          Name of Lapack library (default: openblas).

--superlu-inc              Location of SuperLU headers.
--superlu-lib              Location of SuperLU library.
--superlu-lib-name         Name of SuperLU library (default: superlu).

--mpi-inc                  Location of MPI headers.
--mpi-lib                  Location to MPI library.

--nccl-inc                 Location of NCCL headers.
--nccl-lib                 Location to NCCL library.

--rccl-inc                 Location of RCCL headers (default: \$ROCM_PATH/include).
--rccl-lib                 Location to RCCL library (default: \$ROCM_PATH/lib).

--cudss-inc                Location of cuDSS headers.
--cudss-lib                Location to cuDSS library.

--lua-inc                  Location of Lua headers.
--lua-lib                  Location to Lua library.

--cudamath-lib             Location of CUDA math libraries.

EOF
}

# Helper functions

find_program() {
   prog=`command -v "$1" 2>/dev/null`
   if [ -n "$prog" ]
   then
      dirname "$prog"
   fi
}

die() {
   echo "$*"
   echo
   echo "Configured failed."
   echo
   exit 1
}

# ----------------------------------------------------------------------------
# MAIN PROGRAM
# ----------------------------------------------------------------------------

# Parse options

while [ -n "$1" ]
do
   value="`echo $1 | sed 's/[^=]*.\(.*\)/\1/'`"
   key="`echo $1 | sed 's/=.*//'`"
   if `echo "$value" | grep "~" >/dev/null 2>/dev/null`
   then
      echo
      echo '*WARNING*: the "~" sign is not expanded in flags.'
      echo 'If you mean the home directory, use $HOME instead.'
      echo
   fi
   case "$key" in
   -h)
      show_help
      exit 0
      ;;
   --help)
      show_help
      exit 0
      ;;
   CC)
      [ -n "$value" ] || die "Missing value in flag $key."
      CC="$value"
      ;;
   GPUCXX)
      [ -n "$value" ] || die "Missing value in flag $key."
      GPUCXX="$value"
      ;;
   ARCH_FLAGS)
      [ -n "$value" ] || die "Missing value in flag $key."
      ARCH_FLAGS="$value"
      ;;
   CUDA_ARCH)
      [ -n "$value" ] || die "Missing value in flag $key."
      CUDA_ARCH="$value"
      ;;
   GPU_ARCH)
      [ -n "$value" ] || die "Missing value in flag $key."
      GPU_ARCH="$value"
      ;;
   ROCM_PATH)
      [ -n "$value" ] || die "Missing value in flag $key."
      ROCM_PATH="$value"
      ;;
   --prefix)
      [ -n "$value" ] || die "Missing value in flag $key."
      PREFIX="$value"
      ;;
   --app)
      [ -n "$value" ] || die "Missing value in flag $key."
      APP="$value"
      ;;
   --lapack-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      LAPACK_INC_DIR="$value"
      ;;
   --lapack-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      LAPACK_LIB_DIR="$value"
      ;;
   --lapack-lib-name)
      [ -n "$value" ] || die "Missing value in flag $key."
      LAPACK_LIB_NAME="$value"
      ;;
   --superlu-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      SUPERLU_INC_DIR="$value"
      ;;
   --superlu-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      SUPERLU_LIB_DIR="$value"
      ;;
   --superlu-lib-name)
      [ -n "$value" ] || die "Missing value in flag $key."
      SUPERLU_LIB_NAME="$value"
      ;;
   --use-mpi)
      [ -n "$value" ] || die "Missing value in flag $key."
      USE_MPI="$value"
      ;;       
   --mpi-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_MPI_INC_DIR="$value"
      ;;
   --mpi-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_MPI_LIB_DIR="$value"
      ;;
   --use-hip)
      [ -n "$value" ] || die "Missing value in flag $key."
      USE_HIP="$value"
      ;;
   --use-nccl)
      [ -n "$value" ] || die "Missing value in flag $key."
      USE_NCCL="$value"
      ;;
   --nccl-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_NCCL_INC_DIR="$value"
      ;;
   --nccl-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_NCCL_LIB_DIR="$value"
      ;;
   --use-rccl)
      [ -n "$value" ] || die "Missing value in flag $key."
      USE_RCCL="$value"
      ;;
   --rccl-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_RCCL_INC_DIR="$value"
      ;;
   --rccl-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_RCCL_LIB_DIR="$value"
      ;;
   --use-cudss)
      [ -n "$value" ] || die "Missing value in flag $key."
      USE_CUDSS="$value"
      ;;       
   --cudss-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_CUDSS_INC_DIR="$value"
      ;;
   --cudss-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_CUDSS_LIB_DIR="$value"
      ;;
   --use-lua)
      [ -n "$value" ] || die "Missing value in flag $key."
      USE_LUA="$value"
      ;;       
   --lua-inc)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_LUA_INC_DIR="$value"
      ;;
   --lua-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      CONF_LUA_LIB_DIR="$value"
      ;;   
   --cudamath-lib)
      [ -n "$value" ] || die "Missing value in flag $key."
      CUDAMATH_LIB_DIR="$value"
      ;;
   *)
      die "Error: Unknown flag: $1"
      ;;
   esac
   shift
done

if [ "$USE_MPI" = "yes" ]
then
    USE_MPI=1
else
    USE_MPI=
fi

if [ "$USE_NCCL" = "yes" ]
then
    USE_NCCL=1
else
    USE_NCCL=
fi

if [ "$USE_HIP" = "yes" ]
then
    USE_HIP=1
else
    USE_HIP=
fi

if [ "$USE_RCCL" = "yes" ]
then
    USE_RCCL=1
else
    USE_RCCL=
fi

# Sanity: NCCL and RCCL are mutually exclusive, RCCL implies HIP.
if [ -n "$USE_NCCL" ] && [ -n "$USE_RCCL" ]
then
    die "--use-nccl and --use-rccl are mutually exclusive."
fi
if [ -n "$USE_RCCL" ] && [ -z "$USE_HIP" ]
then
    die "--use-rccl=yes requires --use-hip=yes."
fi

# GPU_ARCH falls back to CUDA_ARCH on the CUDA path.
if [ -z "$GPU_ARCH" ]
then
    GPU_ARCH=$CUDA_ARCH
fi

# RCCL include/lib default under ROCM_PATH.
if [ -n "$ROCM_PATH" ]
then
    : "${CONF_RCCL_INC_DIR=$ROCM_PATH/include}"
    : "${CONF_RCCL_LIB_DIR=$ROCM_PATH/lib}"
fi

if [ "$USE_CUDSS" = "yes" ]
then
    USE_CUDSS=1
else
    USE_CUDSS=
fi

if [ "$USE_LUA" = "yes" ]
then
    USE_LUA=1
else
    USE_LUA=
fi

echo "Building APP " $APP

if [ "$APP" = "core" ]
then
    ALLTARGETS="core core-unit core-regression"
    INSTALLTARGET="core-install"
    FIN_APP_LIB_DIR=""
    FIN_APP_LIB=""
elif [ "$APP" = "moments" ]
then
    ALLTARGETS="moments moments-unit moments-regression"
    INSTALLTARGET="moments-install"
    # ${BUILD_DIR} is escaped so make resolves it at build time, not the
    # shell at configure time (which would substitute the empty string
    # before BUILD_DIR is set in the Makefile USING_HIPCC/USING_NVCC arm).
    # Pre-existing bug — the pkpm default at line 14 was correctly
    # escaped; the non-default arms here weren't, so config.mak ended
    # up with FIN_APP_LIB_DIR=-L..//${app} (double slash, missing
    # build dir) and `make gkeyll` couldn't find the app library.
    FIN_APP_LIB_DIR="-L../\${BUILD_DIR}/moments"
    FIN_APP_LIB_NAME=${FIN_APP_LIB_DIR}/libg0moments.so
    FIN_APP_LIB="-lg0moments"
elif [ "$APP" = "vlasov" ]
then
    ALLTARGETS="vlasov vlasov-unit vlasov-regression"
    INSTALLTARGET="vlasov-install"
    FIN_APP_LIB_DIR="-L../\${BUILD_DIR}/vlasov"
    FIN_APP_LIB_NAME=${FIN_APP_LIB_DIR}/libg0vlasov.so
    FIN_APP_LIB="-lg0vlasov"
elif [ "$APP" = "gyrokinetic" ]
then
    ALLTARGETS="gyrokinetic gyrokinetic-unit gyrokinetic-regression"
    INSTALLTARGET="gyrokinetic-install"
    FIN_APP_LIB_DIR="-L../\${BUILD_DIR}/gyrokinetic"
    FIN_APP_LIB_NAME=${FIN_APP_LIB_DIR}/libg0gyrokinetic.so
    FIN_APP_LIB="-lg0gyrokinetic"
elif [ "$APP" = "pkpm" ]
then
    ALLTARGETS="pkpm pkpm-unit pkpm-regression"
    INSTALLTARGET="pkpm-install"
else
    APP=all
    ALLTARGETS=gkeyll
    INSTALLTARGET=gkeyll
fi

# Default lapack include and libraries: we prefer linking to static library
: "${LAPACK_INC_DIR:=$PREFIX/OpenBLAS/include/}"
: "${LAPACK_LIB_DIR=$PREFIX/OpenBLAS/lib/}"
: "${LAPACK_LIB_NAME=openblas}"

# MPI specific paths and flags
: "${CONF_MPI_INC_DIR=$PREFIX/openmpi/include/}"
: "${CONF_MPI_LIB_DIR=$PREFIX/openmpi/lib/}"

# Lua specific paths and flags
: "${CONF_LUA_INC_DIR=$PREFIX/luajit/include/luajit-2.1/}"
: "${CONF_LUA_LIB_DIR=$PREFIX/luajit/lib/}"

# cuDSS specific paths and flags
: "${CONF_CUDSS_INC_DIR=$PREFIX/cuDSS/include/}"
: "${CONF_CUDSS_LIB_DIR=$PREFIX/cuDSS/lib/}"

# SuperLU includes and librararies
: "${SUPERLU_INC_DIR=$PREFIX/superlu/include/}"
if [ "$OSTYPE" = "linux-gnu"* ]
then
    : "${SUPERLU_LIB_DIR=$PREFIX/superlu/lib64/}"
else
    : "${SUPERLU_LIB_DIR=$PREFIX/superlu/lib/}"
fi
: "${SUPERLU_LIB_NAME=superlu}"

# Write out config.mak
cat <<EOF1 > config.mak
# Generated automatically! Do not edit

# Installation directory
PREFIX=$PREFIX
# Compilers
CC=$CC
GPUCXX=$GPUCXX
ARCH_FLAGS=$ARCH_FLAGS
CUDA_ARCH=$CUDA_ARCH
GPU_ARCH=$GPU_ARCH

# ROCm install root (used when GPUCXX=hipcc)
ROCM_PATH=$ROCM_PATH

# App to build
BUILD_APP=$APP

# Library paths
LAPACK_INC_DIR=$LAPACK_INC_DIR
LAPACK_LIB_DIR=$LAPACK_LIB_DIR
LAPACK_LIB_NAME=$LAPACK_LIB_NAME

SUPERLU_INC_DIR=$SUPERLU_INC_DIR
SUPERLU_LIB_DIR=$SUPERLU_LIB_DIR
SUPERLU_LIB_NAME=$SUPERLU_LIB_NAME

USE_MPI=$USE_MPI
CONF_MPI_INC_DIR=$CONF_MPI_INC_DIR
CONF_MPI_LIB_DIR=$CONF_MPI_LIB_DIR

USE_NCCL=$USE_NCCL
CONF_NCCL_INC_DIR=$CONF_NCCL_INC_DIR
CONF_NCCL_LIB_DIR=$CONF_NCCL_LIB_DIR

USE_HIP=$USE_HIP
USE_RCCL=$USE_RCCL
CONF_RCCL_INC_DIR=$CONF_RCCL_INC_DIR
CONF_RCCL_LIB_DIR=$CONF_RCCL_LIB_DIR

USE_CUDSS=$USE_CUDSS
CONF_CUDSS_INC_DIR=$CONF_CUDSS_INC_DIR
CONF_CUDSS_LIB_DIR=$CONF_CUDSS_LIB_DIR

USE_LUA=$USE_LUA
CONF_LUA_INC_DIR=$CONF_LUA_INC_DIR
CONF_LUA_LIB_DIR=$CONF_LUA_LIB_DIR
CONF_LUA_LIB=$CONF_LUA_LIB

CUDAMATH_LIB_DIR=$CUDAMATH_LIB_DIR

FIN_APP_LIB_DIR=$FIN_APP_LIB_DIR
FIN_APP_LIB=$FIN_APP_LIB

.PHONY:
all: $ALLTARGETS ## Build only specified Apps ($APP)

.PHONY: install
install: $INSTALLTARGET ## Install gkeyll executable
	cd gkeyll && \${MAKE} -f Makefile-gkeyll install

EOF1

echo "# Wrote config.mak with contents:"
cat config.mak
